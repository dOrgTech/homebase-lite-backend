ATLAS_URI=#YOUR_MONGODB_URI
PORT=#YOUR_NONDEFAULT_APP_PORT
NFT_STORAGE_KEY=XXXXXX #TokenFrom Nft.Storage

# Email alerts (DAO subscriptions). Leave SMTP_HOST empty to disable sending.
SMTP_HOST=#smtp.example.com
SMTP_PORT=587 #465 for implicit TLS, anything else uses STARTTLS
SMTP_USER=#YOUR_SMTP_USERNAME
SMTP_PASS=#YOUR_SMTP_PASSWORD
MAIL_FROM=Homebase Alerts <alerts@tezos-homebase.io>

# Public URLs used to build links inside outgoing mail
APP_URL=https://tezos-homebase.io
PUBLIC_API_URL=https://homebase-backend.netlify.app
